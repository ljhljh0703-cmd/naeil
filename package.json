{
  "name": "naeil",
  "version": "0.0.2",
  "description": "내 일은 naeil에서 · AI 세션을 오가도 어제 한 일을 잃지 않는 1인 개발자 작업판",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "npm run build:web && tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:web",
    "lint:api": "npx -y @redocly/cli@1 lint docs/api/openapi.yaml",
    "key": "tsx --env-file-if-exists=.env src/cli/key.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "serve": "tsx --env-file-if-exists=.env src/server.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
